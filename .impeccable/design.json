  "narrative": {
    "northStar": "The Public Reference Register",
    "overview": "DerekDesk is a working register: deep ink-blue navigation above cool pale-blue ground, with white areas for writing and reading. System typography, explicit labels and quiet rules keep the attention on the question, approved text and its source. The authority comes from visible provenance and actual status.\n\nThe signature is a connected source block containing a link, authored excerpt, version and review deadline. An employee reply follows as a separately headed, timestamped response; it does not replace that original evidence. RU and KK visitor chrome share the same visual hierarchy, while source material retains its authored language. The register has no ornamental imagery, gradients, card shadows or ambient animation in the current implementation.\n\nThis is a scan of the built `public/index.html`, `public/styles.css` and `public/app.js`, grounded by `.impeccable/surface.md` (candidate 5; `seed:3c78d412b26a4ca6`). No approved comp or QUALITY BAR card was supplied. The final `.impeccable/review/verdict-pass.md` clears the four listed fixes at the supplied capture scope; it is not a new whole-surface review. The opened evidence is `desktop.png` (1440-wide), `user-1280.png` (1280-wide), `mobile.png` (390-wide), `kazakh-chrome.png` and `multi-case-queue.png`. Focus, error and long-content treatments below are code-derived, not newly browser-verified. All captured business records are synthetic.",
    "keyCharacteristics": [
      "Cool reading ground and a stable navy shell.",
      "Flat, ruled white panels with gently curved corners.",
      "Explicit form labels and ordinary, legible web controls.",
      "Approved evidence and human response remain visibly distinct.",
      "Compact desktop work areas reflow into a complete phone reading order."
    ],
    "rules": [
      {
        "name": "The Written Status Rule",
        "body": "Semantic color accompanies a written state; color does not carry the status alone. The current material list uses teal for both approved and draft text unless the material is expired, so teal must not be interpreted as proof of approval by itself.",
        "section": "colors"
      },
      {
        "name": "The Evidence Reading Rule",
        "body": "Keep source excerpt, version and review deadline readable in the same flow as the approved answer. Do not reduce the evidence to an icon or hover-only disclosure.",
        "section": "typography"
      },
      {
        "name": "The Flat Register Rule",
        "body": "Use surface tone, spacing and rules to separate work. Preserve the flat treatment when extending the current world.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep approved text, linked source, excerpt, version and review deadline in one continuous reading flow.",
      "Do keep an employee reply separately headed and timestamped beneath retained source evidence.",
      "Do use a written status together with teal or amber.",
      "Do retain explicit, uniquely associated labels and the shared visible focus outline.",
      "Do preserve question/form before result when paired work areas stack on a phone.",
      "Do localize visitor chrome while retaining source material in its authored language."
    ],
    "donts": [
      "Don't add shadows, gradients or ambient motion to the current flat register vocabulary.",
      "Don't turn every repeated entry into another rounded card.",
      "Don't hide provenance behind an icon, tooltip or collapsed decorative badge.",
      "Don't interpret teal text alone as an approval guarantee.",
      "Don't present the supplied fix verdict as a full new surface review or a company pilot."
    ]
  }
}
